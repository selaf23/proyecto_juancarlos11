# ============================================================
# Configuración del Sistema de Visibilización de Producción
# Académica — UNIMINUTO
#
# Instrucciones:
#   1. Copia este archivo y renómbralo a .env
#        cp .env.example .env
#   2. Completa cada valor con tus credenciales reales.
#   3. NUNCA subas el archivo .env a Git (ya está ignorado).
# ============================================================

# ---------- Base de datos PostgreSQL ----------
DB_HOST=localhost
DB_PORT=5432
DB_NAME=sistema_articulos
DB_USER=postgres
DB_PASSWORD=tu_password_aqui

# ---------- Groq / LLaMA (generación de contenido con IA) ----------
# Consigue tu API key en: https://console.groq.com/keys
GROQ_API_KEY=gsk_tu_api_key_aqui

# ---------- Unsplash (fotos para las tarjetas visuales) ----------
# Consigue tu API key en: https://unsplash.com/developers
UNSPLASH_ACCESS_KEY=tu_unsplash_access_key_aqui

# ---------- Repositorio académico UNIMINUTO (API DSpace 7) ----------
REPOSITORIO_URL=https://repository.uniminuto.edu
# ID (UUID) de la comunidad/colección dentro del repositorio
REPOSITORIO_COMUNIDAD_ACADEMICA=tu_uuid_de_comunidad_aqui
